{
    "name": "alnet/devoir-touche-pas-au-klaxon",
    "description": "Application de covoiturage inter-sites développée en PHP MVC / Cross-site carpooling application developed in PHP MVC",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
